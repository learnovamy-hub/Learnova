import 'dart:js';

import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';
// ignore: avoid_web_libraries_in_flutter
import 'dart:js' as js;
import '../config/constants.dart';

class LessonStep {
  final int id;
  final String type;
  final String title;
  final String text;
  final String voiceScript;
  LessonStep({required this.id, required this.type, required this.title, required this.text, required this.voiceScript});
  factory LessonStep.fromJson(Map<String, dynamic> j) => LessonStep(
    id: j['id'] as int, type: j['type'] as String,
    title: j['title'] as String, text: j['text'] as String,
    voiceScript: j['voice_script'] as String? ?? j['text'] as String);
}

class CheckIn {
  final int afterStepId;
  final String question;
  final List<String> options;
  final int correctIndex;
  final String explanation;
  CheckIn({required this.afterStepId, required this.question, required this.options, required this.correctIndex, required this.explanation});
  factory CheckIn.fromJson(Map<String, dynamic> j) => CheckIn(
    afterStepId: j['after_step_id'] as int,
    question: j['question'] as String,
    options: List<String>.from(j['options'] as List),
    correctIndex: j['correct_index'] as int,
    explanation: j['explanation'] as String);
}

class LessonPlayerScreen extends StatefulWidget {
  final Map<String, dynamic> lesson;
  const LessonPlayerScreen({Key? key, required this.lesson}) : super(key: key);
  @override
  State<LessonPlayerScreen> createState() => _LessonPlayerScreenState();
}

class _LessonPlayerScreenState extends State<LessonPlayerScreen> with SingleTickerProviderStateMixin {
  List<LessonStep> _steps = [];
  List<CheckIn> _checkIns = [];
  List<dynamic> _sequence = []; // LessonStep or CheckIn
  int _current = 0;
  bool _ttsEnabled = true;
  bool _speaking = false;
  int? _selectedAnswer;
  bool _answerRevealed = false;
  late AnimationController _slideCtrl;
  late Animation<Offset> _slideAnim;

  @override
  void initState() {
    super.initState();
    _slideCtrl = AnimationController(vsync: this, duration: const Duration(milliseconds: 350));
    _slideAnim = Tween<Offset>(begin: const Offset(1, 0), end: Offset.zero)
        .animate(CurvedAnimation(parent: _slideCtrl, curve: Curves.easeOut));
    _loadSteps();
  }

  void _loadSteps() {
    final stepsData = widget.lesson['steps'];
    if (stepsData == null) return;
    final Map<String, dynamic> data = stepsData is Map ? Map<String, dynamic>.from(stepsData) : {};
    _steps = ((data['steps'] as List?) ?? []).map((e) => LessonStep.fromJson(Map<String, dynamic>.from(e))).toList();
    _checkIns = ((data['check_ins'] as List?) ?? []).map((e) => CheckIn.fromJson(Map<String, dynamic>.from(e))).toList();
    // Build sequence: interleave check-ins after their target step
    final seq = <dynamic>[];
    for (final step in _steps) {
      seq.add(step);
      for (final ci in _checkIns) {
        if (ci.afterStepId == step.id) seq.add(ci);
      }
    }
    setState(() => _sequence = seq);
    _slideCtrl.forward();
    if (_ttsEnabled) _speak();
  }

  void _speak() {
    final item = _sequence.isEmpty ? null : _sequence[_current];
    if (item == null) return;
    String text = '';
    if (item is LessonStep) text = item.voiceScript;
    else if (item is CheckIn) text = item.question;
    if (text.isEmpty) return;
    setState(() => _speaking = true);
    try {
      final synth = js.context['speechSynthesis'];
      if (synth == null) { setState(() => _speaking = false); return; }
      synth.callMethod('cancel', []);
      final utterance = js.JsObject(js.context['SpeechSynthesisUtterance'], [text]);
      utterance['rate'] = 0.92;
      utterance['pitch'] = 1.05;
      utterance['onend'] = js.allowInterop((_) { if (mounted) setState(() => _speaking = false); });
      utterance['onerror'] = js.allowInterop((_) { if (mounted) setState(() => _speaking = false); });
      synth.callMethod('speak', [utterance]);
    } catch (_) { setState(() => _speaking = false); }
  }

  void _stopSpeech() {
    try { js.context['speechSynthesis']?.callMethod('cancel', []); } catch (_) {}
    if (mounted) setState(() => _speaking = false);
  }

  void _next() {
    if (_current >= _sequence.length - 1) {
      Navigator.pop(context);
      return;
    }
    _stopSpeech();
    setState(() {
      _current++;
      _selectedAnswer = null;
      _answerRevealed = false;
    });
    _slideCtrl.reset();
    _slideCtrl.forward();
    if (_ttsEnabled) Future.delayed(const Duration(milliseconds: 300), _speak);
  }

  void _prev() {
    if (_current <= 0) return;
    _stopSpeech();
    setState(() {
      _current--;
      _selectedAnswer = null;
      _answerRevealed = false;
    });
    _slideCtrl.reset();
    _slideCtrl.forward();
    if (_ttsEnabled) Future.delayed(const Duration(milliseconds: 300), _speak);
  }

  bool get _canProceed {
    final item = _sequence.isEmpty ? null : _sequence[_current];
    if (item is CheckIn) return _answerRevealed;
    return true;
  }

  Color _stepColor(String type) {
    switch (type) {
      case 'objectives': return const Color(0xFF06B6D4);
      case 'prior_knowledge': return const Color(0xFF8B5CF6);
      case 'concept': return kPrimary;
      case 'formula': return const Color(0xFFF59E0B);
      case 'example': return kGreen;
      case 'working': return const Color(0xFF3B82F6);
      case 'connection': return const Color(0xFF06B6D4);
      case 'mistake': return kRed;
      case 'summary': return kGreen;
      default: return kPrimary;
    }
  }

  IconData _stepIcon(String type) {
    switch (type) {
      case 'objectives': return Icons.flag_rounded;
      case 'prior_knowledge': return Icons.menu_book_rounded;
      case 'concept': return Icons.lightbulb_rounded;
      case 'formula': return Icons.functions_rounded;
      case 'example': return Icons.description_rounded;
      case 'working': return Icons.edit_rounded;
      case 'connection': return Icons.link_rounded;
      case 'mistake': return Icons.warning_rounded;
      case 'summary': return Icons.check_circle_rounded;
      default: return Icons.circle_rounded;
    }
  }

  @override
  Widget build(BuildContext context) {
    if (_sequence.isEmpty) {
      return Scaffold(
        backgroundColor: kBg,
        appBar: AppBar(title: Text(widget.lesson['title'] ?? 'Lesson')),
        body: const Center(child: Text('No steps available yet.', style: TextStyle(color: kMuted))),
      );
    }
    final total = _sequence.length;
    final progress = (_current + 1) / total;
    final item = _sequence[_current];
    final isCheckIn = item is CheckIn;

    return Scaffold(
      backgroundColor: kBg,
      appBar: AppBar(
        backgroundColor: kSurface,
        title: Text(widget.lesson['title'] ?? 'Lesson',
          style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w700)),
        actions: [
          IconButton(
            icon: Icon(_speaking ? Icons.volume_up_rounded : Icons.volume_off_rounded,
              color: _speaking ? kPrimary : kMuted, size: 20),
            onPressed: () {
              if (_speaking) { _stopSpeech(); setState(() => _ttsEnabled = false); }
              else { setState(() => _ttsEnabled = true); _speak(); }
            },
          ),
        ],
      ),
      body: Column(children: [
        // Progress bar
        LinearProgressIndicator(value: progress, backgroundColor: kBorder,
          valueColor: const AlwaysStoppedAnimation<Color>(kPrimary), minHeight: 3),
        Padding(
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
          child: Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
            Text('Step ${_current + 1} of $total',
              style: const TextStyle(color: kMuted, fontSize: 12)),
            if (_speaking)
              Row(children: [
                Container(width: 6, height: 6, decoration: const BoxDecoration(color: kPrimary, shape: BoxShape.circle)),
                const SizedBox(width: 4),
                const Text('Speaking...', style: TextStyle(color: kPrimary, fontSize: 11)),
              ]),
          ]),
        ),
        // Card
        Expanded(
          child: SlideTransition(
            position: _slideAnim,
            child: Padding(
              padding: const EdgeInsets.fromLTRB(16, 4, 16, 16),
              child: isCheckIn ? _buildCheckIn(item) : _buildStep(item),
            ),
          ),
        ),
        // Nav buttons
        Padding(
          padding: EdgeInsets.fromLTRB(16, 0, 16, MediaQuery.of(context).padding.bottom + 16),
          child: Row(children: [
            if (_current > 0)
              Expanded(
                child: OutlinedButton(
                  onPressed: _prev,
                  style: OutlinedButton.styleFrom(
                    side: const BorderSide(color: kBorder),
                    padding: const EdgeInsets.symmetric(vertical: 14)),
                  child: const Text('Back', style: TextStyle(color: kMuted)),
                ),
              ),
            if (_current > 0) const SizedBox(width: 12),
            Expanded(
              flex: 2,
              child: ElevatedButton(
                onPressed: _canProceed ? _next : null,
                style: ElevatedButton.styleFrom(
                  backgroundColor: kPrimary,
                  padding: const EdgeInsets.symmetric(vertical: 14),
                  disabledBackgroundColor: kBorder),
                child: Text(
                  _current == total - 1 ? 'Complete' : 'Continue',
                  style: const TextStyle(color: Colors.white, fontWeight: FontWeight.w700)),
              ),
            ),
          ]),
        ),
      ]),
    );
  }

  Widget _buildStep(LessonStep step) {
    final color = _stepColor(step.type);
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(24),
      decoration: BoxDecoration(
        color: kSurface,
        borderRadius: BorderRadius.circular(20),
        border: Border.all(color: color.withOpacity(0.3))),
      child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        Row(children: [
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
            decoration: BoxDecoration(
              color: color.withOpacity(0.15),
              borderRadius: BorderRadius.circular(20),
              border: Border.all(color: color.withOpacity(0.4))),
            child: Row(mainAxisSize: MainAxisSize.min, children: [
              Icon(_stepIcon(step.type), color: color, size: 14),
              const SizedBox(width: 6),
              Text(step.type.replaceAll('_', ' ').toUpperCase(),
                style: TextStyle(color: color, fontSize: 10, fontWeight: FontWeight.w800, letterSpacing: 1)),
            ]),
          ),
        ]),
        const SizedBox(height: 16),
        Text(step.title,
          style: const TextStyle(color: kText, fontSize: 20, fontWeight: FontWeight.w800, height: 1.3)),
        const SizedBox(height: 16),
        Expanded(
          child: SingleChildScrollView(
            child: Text(step.text,
              style: const TextStyle(color: kText, fontSize: 15, height: 1.7)),
          ),
        ),
      ]),
    );
  }

  Widget _buildCheckIn(CheckIn ci) {
    return SingleChildScrollView(
      child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        Container(
          width: double.infinity,
          padding: const EdgeInsets.all(20),
          decoration: BoxDecoration(
            color: kPrimary.withOpacity(0.08),
            borderRadius: BorderRadius.circular(16),
            border: Border.all(color: kPrimary.withOpacity(0.3))),
          child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Row(children: [
              const Icon(Icons.quiz_rounded, color: kPrimary, size: 16),
              const SizedBox(width: 8),
              const Text('CHECK-IN', style: TextStyle(color: kPrimary, fontSize: 11, fontWeight: FontWeight.w800, letterSpacing: 1)),
            ]),
            const SizedBox(height: 12),
            Text(ci.question, style: const TextStyle(color: kText, fontSize: 16, fontWeight: FontWeight.w600, height: 1.5)),
          ]),
        ),
        const SizedBox(height: 16),
        ...ci.options.asMap().entries.map((e) {
          final idx = e.key;
          final opt = e.value;
          final isSelected = _selectedAnswer == idx;
          final isCorrect = idx == ci.correctIndex;
          Color borderColor = kBorder;
          Color bgColor = kSurface;
          Color textColor = kText;
          if (_answerRevealed) {
            if (isCorrect) { borderColor = kGreen; bgColor = kGreen.withOpacity(0.1); textColor = kGreen; }
            else if (isSelected) { borderColor = kRed; bgColor = kRed.withOpacity(0.1); textColor = kRed; }
          } else if (isSelected) {
            borderColor = kPrimary; bgColor = kPrimary.withOpacity(0.1); textColor = kPrimary;
          }
          return GestureDetector(
            onTap: _answerRevealed ? null : () {
              setState(() { _selectedAnswer = idx; _answerRevealed = true; });
              if (_ttsEnabled) {
                final feedback = isCorrect ? 'Correct! Well done. ${ci.explanation}' : 'Not quite. ${ci.explanation}';
                Future.delayed(const Duration(milliseconds: 300), () {
                  _stopSpeech();
                  Future.delayed(const Duration(milliseconds: 100), () {
                    try {
                      final synth = js.context['speechSynthesis'];
                      if (synth == null) return;
                      final utt = js.JsObject(js.context['SpeechSynthesisUtterance'], [feedback]);
                      utt['rate'] = 0.92;
                      synth.callMethod('speak', [utt]);
                    } catch (_) {}
                  });
                });
              }
            },
            child: Container(
              margin: const EdgeInsets.only(bottom: 10),
              padding: const EdgeInsets.all(14),
              decoration: BoxDecoration(
                color: bgColor, borderRadius: BorderRadius.circular(12),
                border: Border.all(color: borderColor, width: isSelected || (_answerRevealed && isCorrect) ? 2 : 1)),
              child: Row(children: [
                Container(
                  width: 28, height: 28,
                  decoration: BoxDecoration(
                    color: borderColor.withOpacity(0.15),
                    shape: BoxShape.circle,
                    border: Border.all(color: borderColor)),
                  child: Center(child: Text(['A','B','C','D'][idx],
                    style: TextStyle(color: borderColor, fontSize: 12, fontWeight: FontWeight.w800)))),
                const SizedBox(width: 12),
                Expanded(child: Text(opt, style: TextStyle(color: textColor, fontSize: 14, fontWeight: FontWeight.w500))),
                if (_answerRevealed && isCorrect) const Icon(Icons.check_circle_rounded, color: kGreen, size: 20),
                if (_answerRevealed && isSelected && !isCorrect) const Icon(Icons.cancel_rounded, color: kRed, size: 20),
              ]),
            ),
          );
        }),
        if (_answerRevealed) ...[
          const SizedBox(height: 8),
          Container(
            padding: const EdgeInsets.all(14),
            decoration: BoxDecoration(
              color: kGreen.withOpacity(0.08),
              borderRadius: BorderRadius.circular(12),
              border: Border.all(color: kGreen.withOpacity(0.3))),
            child: Row(crossAxisAlignment: CrossAxisAlignment.start, children: [
              const Icon(Icons.lightbulb_rounded, color: kGreen, size: 16),
              const SizedBox(width: 8),
              Expanded(child: Text(ci.explanation,
                style: const TextStyle(color: kText, fontSize: 13, height: 1.5))),
            ]),
          ),
        ],
      ]),
    );
  }

  @override
  void dispose() {
    _stopSpeech();
    _slideCtrl.dispose();
    super.dispose();
  }
}

