# Enable mod_rewrite
Options -MultiViews
RewriteEngine On

# /clear → clear.html (cache buster page)
RewriteRule ^clear$ /clear.html [L]

# Force no-cache for Flutter app shell — ensures mobile browsers always get latest build
<FilesMatch "\.(html|js|json)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Allow caching for assets (fonts, images, icons) — these rarely change
<FilesMatch "\.(png|jpg|jpeg|gif|svg|ttf|woff|woff2|ico)$">
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>

# Flutter SPA fallback — route unknown paths to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(?!clear$).*$ /index.html [L]
